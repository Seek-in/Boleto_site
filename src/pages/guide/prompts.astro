---
import { marked } from 'marked';
import GuideLayout from '../../layouts/GuideLayout.astro';
import { readGuideMarkdown, extractGuidePrompts } from '../../lib/guide-icons';

const markdown = readGuideMarkdown('prompts/boleto_prompts.md');
const prompts = extractGuidePrompts(markdown);

// Règles ADN : tout avant le premier PROMPT A
const rulesMarkdown = markdown.split('## PROMPT A')[0];
const rulesHtml = marked.parse(rulesMarkdown);
---

<GuideLayout title="Kit de prompts" description="Prompts de génération des icônes Boleto">
  <div class="prompts-page">
    <article class="guide-prose prompts-page__rules" set:html={rulesHtml} />

    <section class="prompts-page__blocks" aria-label="Prompts copiables">
      {prompts.map((prompt) => (
        <div class="prompt-block" data-prompt={prompt.id}>
          <div class="prompt-block__head">
            <div>
              <h2>{prompt.title}</h2>
              <p>{prompt.subtitle}</p>
            </div>
            <button
              type="button"
              class="prompt-block__copy"
              data-copy-target={`prompt-text-${prompt.id}`}
              aria-label={`Copier le ${prompt.title}`}
            >
              Copier
            </button>
          </div>
          <pre class="prompt-block__text" id={`prompt-text-${prompt.id}`}><code>{prompt.body}</code></pre>
        </div>
      ))}
    </section>
  </div>
</GuideLayout>

<script>
  function initPromptCopy(): void {
    document.querySelectorAll<HTMLButtonElement>('.prompt-block__copy').forEach((btn) => {
      if (btn.dataset.bound === '1') return;
      btn.dataset.bound = '1';

      btn.addEventListener('click', async () => {
        const targetId = btn.dataset.copyTarget;
        const el = targetId ? document.getElementById(targetId) : null;
        const text = el?.textContent?.trim() ?? '';
        if (!text) return;

        try {
          await navigator.clipboard.writeText(text);
          const prev = btn.textContent;
          btn.textContent = 'Copié ✓';
          btn.classList.add('is-copied');
          window.setTimeout(() => {
            btn.textContent = prev;
            btn.classList.remove('is-copied');
          }, 2000);
        } catch {
          btn.textContent = 'Erreur';
          window.setTimeout(() => {
            btn.textContent = 'Copier';
          }, 2000);
        }
      });
    });
  }

  initPromptCopy();
  document.addEventListener('astro:page-load', initPromptCopy);
</script>

<style>
  .prompts-page {
    max-width: 52rem;
    margin-inline: auto;
    padding-bottom: var(--space-16);
  }

  .prompts-page__rules {
    padding-bottom: var(--space-4);
  }

  .prompts-page__blocks {
    padding: 0 var(--space-6) var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .prompt-block {
    background: white;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .prompt-block__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-5) var(--space-3);
    border-bottom: 1px solid var(--color-border);
    background: #faf8ff;
  }

  .prompt-block__head h2 {
    font-size: var(--font-size-lg);
    color: #5B2D91;
    margin: 0 0 var(--space-1);
    border: none;
    padding: 0;
  }

  .prompt-block__head p {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.5;
  }

  .prompt-block__copy {
    flex-shrink: 0;
    height: 36px;
    padding-inline: var(--space-4);
    font-family: inherit;
    font-size: var(--font-size-sm);
    font-weight: 700;
    color: white;
    background: #5B2D91;
    border: none;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: background var(--transition-fast);
  }

  .prompt-block__copy:hover {
    background: #6E4E86;
  }

  .prompt-block__copy.is-copied {
    background: var(--color-green);
  }

  .prompt-block__text {
    margin: 0;
    padding: var(--space-5);
    background: var(--color-bg-dark);
    color: #f0f0f0;
    font-size: var(--font-size-sm);
    line-height: 1.65;
    overflow-x: auto;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .prompt-block__text code {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    background: none;
    padding: 0;
    color: inherit;
  }
</style>
