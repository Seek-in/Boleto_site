---
import SectionTitle from '../ui/SectionTitle.astro';
import DownloadBadges from '../ui/DownloadBadges.astro';
---

<section class="cta-banner">
  <div class="container cta-banner__inner">
    <div class="cta-banner__content">
      <SectionTitle
        title="Prêt à cumuler ?"
        subtitle="Télécharge Boleto et commence à gagner des points dès ton prochain achat chez un commerce partenaire."
      />
      <DownloadBadges />
    </div>
    <div class="cta-banner__smiley" aria-hidden="true">
      <svg width="120" height="120" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="60" cy="60" r="60" fill="#FFC93C"/>
        <circle cx="42" cy="50" r="6" fill="#2D2235"/>
        <circle cx="78" cy="50" r="6" fill="#2D2235"/>
        <path d="M38 72c8 12 36 12 44 0" stroke="#2D2235" stroke-width="5" stroke-linecap="round"/>
      </svg>
    </div>
  </div>
</section>

<style>
  .cta-banner {
    background: var(--color-bg-dark);
    padding-block: var(--space-12);
    margin-top: var(--space-8);
  }

  .cta-banner__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    flex-wrap: wrap;
  }

  .cta-banner__content :global(.section-heading__title) {
    color: white;
  }

  .cta-banner__content :global(.section-heading__subtitle) {
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: var(--space-6);
  }

  .cta-banner__smiley {
    flex-shrink: 0;
    opacity: 0.9;
  }

  @media (max-width: 640px) {
    .cta-banner__smiley {
      display: none;
    }
  }
</style>
