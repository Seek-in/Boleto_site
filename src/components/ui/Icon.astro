---
type IconName =
  | 'shop'
  | 'smiley'
  | 'sparkles'
  | 'flag'
  | 'crown'
  | 'ticket'
  | 'star'
  | 'tag'
  | 'users'
  | 'chart'
  | 'hourglass'
  | 'gift'
  | 'mail'
  | 'map-pin'
  | 'message'
  | 'download'
  | 'qr';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className } = Astro.props;
---

<span
  class:list={['icon', className]}
  style={`width:${size}px;height:${size}px`}
  aria-hidden="true"
>
  {name === 'shop' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3 9.5 5 3h14l2 6.5"/><path d="M5 9.5h14v11H5z"/><path d="M9 20.5V14h6v6.5"/>
    </svg>
  )}
  {name === 'smiley' && (
    <svg viewBox="0 0 24 24" fill="none">
      <circle cx="12" cy="12" r="11" fill="#FFC93C" stroke="#2D2235" stroke-width="1"/>
      <circle cx="8.5" cy="10" r="1.25" fill="#2D2235"/>
      <circle cx="15.5" cy="10" r="1.25" fill="#2D2235"/>
      <path d="M8 14.5c1.2 1.8 4.8 1.8 6 0" stroke="#2D2235" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  )}
  {name === 'sparkles' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
      <path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1"/>
      <circle cx="12" cy="12" r="3" fill="currentColor" stroke="none"/>
    </svg>
  )}
  {name === 'flag' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <path d="M5 3v18"/><path d="M5 4h11l-2 4 2 4H5"/>
    </svg>
  )}
  {name === 'crown' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3 18h18"/><path d="M5 18 7 8l5 4 5-4 2 10"/>
    </svg>
  )}
  {name === 'ticket' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 8a2 2 0 0 1 0-4h16a2 2 0 0 1 0 4 2 2 0 0 0 0 4 2 2 0 0 0 0 4H4a2 2 0 0 1 0-4 2 2 0 0 0 0-4z"/>
    </svg>
  )}
  {name === 'star' && (
    <svg viewBox="0 0 24 24" fill="currentColor" stroke="none">
      <path d="M12 2l2.9 6.6L22 9.2l-5 4.6 1.5 6.9L12 17.8 5.5 20.7 7 13.8 2 9.2l7.1-.6L12 2z"/>
    </svg>
  )}
  {name === 'tag' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20 12l-8 8-9-9V4h7z"/><circle cx="7.5" cy="7.5" r="1" fill="currentColor" stroke="none"/>
    </svg>
  )}
  {name === 'users' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="9" cy="8" r="3"/><path d="M2 20c0-3.3 3.1-5 7-5s7 1.7 7 5"/><circle cx="17" cy="9" r="2.5"/><path d="M22 20c0-2.5-2.2-4-5-4"/>
    </svg>
  )}
  {name === 'chart' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 19V5"/><path d="M4 19h16"/><path d="M8 15V9M12 15V7M16 15v-5"/>
    </svg>
  )}
  {name === 'hourglass' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <path d="M6 3h12"/><path d="M6 21h12"/><path d="M8 3v3a4 4 0 0 0 4 4 4 4 0 0 0 4-4V3"/><path d="M8 21v-3a4 4 0 0 1 4-4 4 4 0 0 1 4 4v3"/>
    </svg>
  )}
  {name === 'gift' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="10" width="18" height="11" rx="1"/><path d="M12 10v11"/><path d="M3 10h18V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v3z"/><path d="M12 5c-1.5-2-5-2-5 0s3.5 2 5 0 5-2 5 0-3.5-2-5 0"/>
    </svg>
  )}
  {name === 'mail' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>
    </svg>
  )}
  {name === 'map-pin' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 21s7-5.1 7-11a7 7 0 1 0-14 0c0 5.9 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/>
    </svg>
  )}
  {name === 'message' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 5h16a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H8l-4 4V7a2 2 0 0 1 2-2z"/>
    </svg>
  )}
  {name === 'download' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 3v12"/><path d="M7 10l5 5 5-5"/><path d="M5 21h14"/>
    </svg>
  )}
  {name === 'qr' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
      <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M14 14h2v2h-2zM18 14h3v3h-3zM14 18h2v3h-2zM18 18v3M21 18h-3"/>
    </svg>
  )}
</span>

<style>
  .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--color-secondary);
  }

  .icon :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
